# Chặn truy cập trực tiếp vào các file dữ liệu / bí mật (chỉ cho PHP đọc nội bộ).
# database.json chứa mật khẩu (băm), kho key và cấu hình — chỉ được phục vụ qua
# api.php?action=get_db (đã lọc bỏ dữ liệu nhạy cảm). secrets.php giữ API key/token.
<FilesMatch "^(database\.json|secrets\.php|lib_secrets\.php|lib_bank\.php|\.user\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
